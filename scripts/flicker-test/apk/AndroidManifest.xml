<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.emuu.flickertest">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <application android:label="Emuu Flicker Test" android:hardwareAccelerated="true">
        <activity android:name=".VideoActivity" android:exported="true" android:screenOrientation="portrait"
                  android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".GLActivity" android:exported="true" android:screenOrientation="portrait"
                  android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
    </application>
</manifest>
